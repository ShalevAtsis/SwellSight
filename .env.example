# SwellSight platform (P3) — copy to .env and adjust

# Database
DATABASE_URL=postgresql+psycopg2://swellsight:swellsight@localhost:5432/swellsight

# Redis (queue + rate limit + idempotency)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# API mode: set to skip loading sync inference pipeline on API startup
SWELLSIGHT_SKIP_MODEL_SERVER=1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload limits
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=4096
ANALYSES_PER_DAY_LIMIT=5
RATE_LIMIT_PER_MINUTE=60

# Storage: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/uploads
# S3_BUCKET=swellsight-uploads
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1

# Worker / inference
SWELLSIGHT_CHECKPOINT=checkpoints/best_model.pth

# Retention (P5-T13) — run: python scripts/cleanup_uploads.py
UPLOAD_RETENTION_DAYS=7
